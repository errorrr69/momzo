# Momzo server-side secrets — Edge Functions ONLY. Copy to supabase/.env (git-ignored).
# Hard Rule (Build Guide §5): these NEVER ship in the Flutter app. In prod they
# are set as Supabase Function secrets. Use separate keys for dev and prod.
#
# (Note: the repo-root .env.example is Taskmaster's own AI-provider keys — a
# different concern. This file is Momzo's runtime backend secrets.)

# Supabase
SUPABASE_URL=https://uwpmwqsxqociiojeauuk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # bypasses RLS — server-side only (Task 2/10)
SUPABASE_DB_PASSWORD=               # DB password (Task 2) — FLORIE to provide

# AI — Gemini free tier for Phase 1 (single key: Flash default + Pro escalation)
GOOGLE_API_KEY=                     # Task 11/14/17 — FLORIE to provide

# Push — FCM server credentials
FCM_SERVICE_ACCOUNT=                # Task 7 — Firebase service-account JSON/path

# WhatsApp Cloud API (Phase 2)
WHATSAPP_TOKEN=                     # Task 29
WHATSAPP_PHONE_NUMBER_ID=          # Task 29

# Observability
SENTRY_DSN=                         # Task 8
